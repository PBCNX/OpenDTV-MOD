<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- Installable on Android TV / TV boxes (no touchscreen, leanback launcher) as well as on phones -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.software.live_tv" android:required="false" />

    <!-- Channel / program access of the Live Channels (TV provider) database. A TV input can always read and
         write its own rows; these are the standard declarations used by TV input samples. -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- locales_config lists Tagalog as "fil" while its strings are in values-tl, on purpose: a "tl"
         entry never matches and the app would stay in English (TRANSLATING.md). Lint's
         UnusedTranslation does not know that tl and fil are one language, so it is silenced here. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.OpenDtv"
        tools:ignore="UnusedTranslation">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer to open the app when a supported tuner is plugged in (see res/xml/device_filter.xml:
                 the 9175, the 9308, the the GPL-2.0 driver and the the GPL-2.0 driver - not the 9309, whose vendor path is gone) -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <activity
            android:name=".LicensesActivity"
            android:exported="false" />

        <!-- The hidden Developers screen. Its door is a row at the bottom of Settings that stays
             hidden until the unlock gesture is decided, so a normal build reaches it no more than
             it reaches any other non-exported activity. Debug builds export it for adb. -->
        <activity
            android:name=".dev.screen.DeveloperOptionsActivity"
            android:exported="false" />

        <activity
            android:name=".analyzer.AnalyzerActivity"
            android:exported="false" />


        <!-- Milestone-1 diagnostic: lists interfaces and endpoints of the tuner -->
        <activity
            android:name=".analyzer.UsbProbeActivity"
            android:exported="false" />

        <!-- Live Channels: channel scan. Launched by the TV app ("Set up" / "Rescan") and from the TV launcher. -->
        <activity
            android:name=".tv.SetupActivity"
            android:exported="true"
            android:label="@string/app_name_scanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live Channels: the tuner input itself -->
        <service
            android:name=".tv.OpenDtvInputService"
            android:exported="true"
            android:label="@string/app_name_tuner"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/tv_input_service" />
        </service>
    </application>
</manifest>
