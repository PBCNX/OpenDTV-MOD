<?xml version="1.0" encoding="utf-8"?>
<!-- Card inside the analyzer content sheet: one step up from the sheet, never
     brighter than the sheet border. Used by the Tables tab. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/odtv_surface_variant" />
    <corners android:radius="14dp" />
    <stroke
        android:width="1dp"
        android:color="@color/odtv_divider" />
</shape>
