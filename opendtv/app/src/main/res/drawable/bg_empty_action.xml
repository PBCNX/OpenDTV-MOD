<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/odtv_selected_bg" />
            <corners android:radius="18dp" />
            <stroke
                android:width="2dp"
                android:color="@color/odtv_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/odtv_surface_high" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/odtv_accent_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="@color/odtv_accent_dim" />
        </shape>
    </item>
</selector>
