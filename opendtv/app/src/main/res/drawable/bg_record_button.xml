<?xml version="1.0" encoding="utf-8"?>
<!--
  The REC key. The ring is inset to the same 26 dp disc its neighbours wear (40 dp touch
  target, 7 dp in), which leaves just enough room for the word inside. Selected is the
  recording state - a filled red disc, which is what alerts the pulse animator in
  MainActivity.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
            android:insetLeft="7dp"
            android:insetTop="7dp"
            android:insetRight="7dp"
            android:insetBottom="7dp">
            <shape android:shape="oval">
                <solid android:color="@color/odtv_live" />
                <stroke
                    android:width="1.5dp"
                    android:color="@color/odtv_live" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetLeft="7dp"
            android:insetTop="7dp"
            android:insetRight="7dp"
            android:insetBottom="7dp">
            <shape android:shape="oval">
                <solid android:color="@android:color/transparent" />
                <stroke
                    android:width="1.5dp"
                    android:color="@color/odtv_accent" />
            </shape>
        </inset>
    </item>
</selector>
