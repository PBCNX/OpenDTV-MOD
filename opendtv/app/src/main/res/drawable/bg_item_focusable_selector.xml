<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active channel: warm accent border, never a blue focus ring. -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/odtv_selected_bg" />
            <corners android:radius="@dimen/odtv_row_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/odtv_accent" />
        </shape>
    </item>
    <!-- Focused state (TV remote / DPAD). -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/odtv_surface_high" />
            <corners android:radius="@dimen/odtv_row_radius" />
            <stroke
                android:width="2dp"
                android:color="@color/odtv_focus" />
        </shape>
    </item>
    <!-- Pressed state. -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/odtv_surface_high" />
            <corners android:radius="@dimen/odtv_row_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/odtv_on_surface" />
        </shape>
    </item>
    <!-- Default state. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="@dimen/odtv_row_radius" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
