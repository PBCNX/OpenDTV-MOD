<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- LAYER 0: the video tower. Video, the ARIB data page and the tuning card share one frame,
         because they share one rectangle on screen.
           Stretch / Zoom  MainActivity sets frame ratio 0, so the frame is the whole window (as
                           before) and the content fills/crops inside it.
           Automatic / Force 4:3 / Force 16:9  MainActivity sets a ratio and Media3's FIT sizing
                           shrinks this frame to the largest box of that shape that fits; the root
                           FrameLayout centres it, and the black around the box is the root's own
                           background. On a 16:9 tablet screen a 4:3 box is pillarboxed, a 16:9
                           Automatic stream fills the screen exactly; on a 20:9 phone they are
                           pillarboxed and letterbox logic follows the same rule. -->
    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/player_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#000000"
        app:resize_mode="fit">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:resize_mode="fill"
            app:show_buffering="never"
            app:shutter_background_color="#000000"
            app:use_controller="false" />

        <!-- ARIB data broadcast (BML) page, transparent over the video. Empty until DATA is
             pressed. Inside the frame, so a forced box carries the page with it. -->
        <FrameLayout
            android:id="@+id/bml_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Tuning / no-signal card; passive, never takes a tap. Centres on the frame, so on a
             forced box it centres on the video rather than on the window. -->
        <com.pbcnx.opendtvmod.ui.watch.TuningCard
            android:id="@+id/tuning_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <!-- LAYER 1: Wide & Centered Bottom Channel Info Banner / HUD Overlay -->
    <LinearLayout
        android:id="@+id/info_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_frosted_hud"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="20dp"
        android:visibility="visible">

        <!-- Left: Logo, channel number, then status stack -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/hud_iv_logo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="20dp"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/hud_tv_virtual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="28dp"
                    android:text="0.0"
                    android:textColor="#FFFFFF"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hud_status_left"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:maxLines="1"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/hud_tv_network_name"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="marquee"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text="@string/hud_network_placeholder"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="60dp"
            android:layout_marginEnd="24dp"
            android:background="#30FFFFFF" />

        <!-- Middle: Channel Name & Now/Next EPG -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hud_tv_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/unknown_channel"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/hud_tv_now_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/now_placeholder"
                android:textColor="#E0FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hud_tv_next_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/next_placeholder"
                android:textColor="#A0FFFFFF"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/hud_status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hud_tdt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/odtv_on_surface"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/hud_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hud_chip_data"
                        style="@style/Widget.OpenDtv.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/hud_chip_cc"
                        style="@style/Widget.OpenDtv.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CC"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/hud_chip_lock"
                        style="@style/Widget.OpenDtv.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCK"
                        android:textColor="@color/odtv_warning"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/hud_chip_ewbs"
                        style="@style/Widget.OpenDtv.StatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_status_chip_alert_state"
                        android:text="EWBS"
                        android:textColor="@color/strip_chip_ewbs_text"
                        android:visibility="visible" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Right: REC, then the small i, with S/Q directly under them -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="20dp"
            android:gravity="end"
            android:orientation="vertical">

            <!-- Tap-only, like layout-land's: the banner never takes focus on the set,
                 and Settings > ADVANCED > Record Channel is the TV's door to recording. -->
            <TextView
                android:id="@+id/btn_record_land"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_record_button"
                android:clickable="true"
                android:contentDescription="@string/cd_record_channel"
                android:focusable="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="REC"
                android:textColor="@color/record_text_tint"
                android:textSize="9sp" />

            <ImageButton
                android:id="@+id/btn_watch_info_land"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:background="@drawable/bg_watch_info_button"
                android:contentDescription="@string/cd_watch_info"
                android:padding="12dp"
                android:src="@drawable/ic_info"
                app:tint="@color/watch_info_icon_tint" />

            <TextView
                android:id="@+id/hud_signal"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- LAYER 2: Floating Side Drawer Toggle Button ("<") on Right Edge -->
    <ImageButton
        android:id="@+id/btn_open_side_panel"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_frosted_hud"
        android:elevation="20dp"
        android:focusable="true"
        android:clickable="true"
        android:padding="12dp"
        android:src="@drawable/ic_chevron_left"
        app:tint="#FFFFFF"
        android:visibility="visible" />


    <!-- LAYER 3: Right Side Translucent Frosted Panel (Channels / EPG / Favorites / Settings) -->
    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_frosted_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- Tab Layout: Channels, EPG, Favorites, Settings -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            style="@style/Widget.OpenDtv.Tabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/transparent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/odtv_divider" />

        <!-- Content: list, or the shared empty state when the list has no rows -->
        <FrameLayout
            android:id="@+id/list_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="6dp" />

            <include
                android:id="@+id/empty_state"
                layout="@layout/view_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/odtv_divider" />

        <!-- Shared footer: one per-tab line at the bottom of the list (owner, 2026-11-06). -->
        <include
            layout="@layout/view_footer_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.pbcnx.opendtvmod.ui.watch.WatchCardView
        android:id="@+id/watch_info"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:visibility="gone" />

</FrameLayout>
