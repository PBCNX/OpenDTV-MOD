<?xml version="1.0" encoding="utf-8"?>
<!-- Analyzer, phone in landscape (short: under 500 dp tall). Height is the scarce
     resource, so the chrome is folded onto the two lines that already existed:

       header 48 dp   title at the left, the nine tabs at the right - the mux chip
                      is gone (the picker is the Channels action), which is what
                      lets the tab row leave the card column
       row           16:9 preview column, and the card column is just the tab card
                      plus the status board under it
       bottom 60 dp   the five actions
       status 18 dp   mux, transfer state and the dBm/BER readout, one thin line

     The TV version lives in layout-h500dp-land and keeps its chip and its strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/odtv_bg"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Signal &amp; TS Analyzer"
            android:textColor="@color/odtv_on_surface"
            android:textSize="18sp" />

        <!-- weight 1 + gravity end: the tabs sit flush right, and they still cap at
             the available width, so an overflowing row scrolls instead of clipping. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <include
                layout="@layout/view_analyzer_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 0.44 of 833 dp: at this height a 16:9 picture needs 379 dp, so the frame
             and the picture agree almost exactly. -->
        <FrameLayout
            android:id="@+id/preview_box"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.44"
            android:background="#000000">

            <androidx.media3.ui.AspectRatioFrameLayout
                android:id="@+id/player_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center">

                <androidx.media3.ui.PlayerView
                    android:id="@+id/player_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:show_buffering="never"
                    app:use_controller="false" />
            </androidx.media3.ui.AspectRatioFrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="0.56"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_scan_sheet"
                android:padding="10dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none">

                    <TextView
                        android:id="@+id/tv_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/odtv_on_surface"
                        android:textSize="12sp" />
                </ScrollView>

                <include
                    layout="@layout/view_analyzer_signal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    layout="@layout/view_analyzer_services"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    layout="@layout/view_analyzer_pids"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    layout="@layout/view_analyzer_tables"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    layout="@layout/view_analyzer_graph"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <include
                    layout="@layout/view_analyzer_logs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- stays last: the blocking card owns the tab content -->
                <include
                    layout="@layout/view_analyzer_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <include
        layout="@layout/view_analyzer_actions"
        android:layout_width="match_parent"
        android:layout_height="60dp" />

    <!-- The transient strip, demoted to a readout line at the bottom of the screen:
         18 dp, and it carries the mux too, since the header chip is gone. -->
    <include
        layout="@layout/view_analyzer_strip"
        android:layout_width="match_parent"
        android:layout_height="18dp" />
</LinearLayout>
