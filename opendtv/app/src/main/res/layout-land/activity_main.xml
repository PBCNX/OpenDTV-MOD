<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- LAYER 0: FULL SCREEN Live TV Video Player -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:resize_mode="fill"
        app:show_buffering="when_playing"
        app:shutter_background_color="#000000"
        app:use_controller="false" />

    <!-- LAYER 0.5: ARIB data broadcast (BML) page. Empty until DATA is pressed; transparent, over the video. -->
    <FrameLayout
        android:id="@+id/bml_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- LAYER 1: Wide & Centered Bottom Channel Info Banner / HUD Overlay -->
    <LinearLayout
        android:id="@+id/info_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_frosted_hud"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp"
        android:visibility="visible">

        <!-- Left: Logo & Channel Number -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hud_iv_logo"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/hud_tv_virtual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="0.0"
                android:textColor="#FFFFFF"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="50dp"
            android:layout_marginEnd="20dp"
            android:background="#30FFFFFF" />

        <!-- Middle: Channel Name & Now/Next EPG -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hud_tv_channel_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Unknown Channel"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hud_tv_network_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="No Channel Info"
                    android:textColor="#B0FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/hud_tv_now_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Now: No current data available."
                android:textColor="#E0FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hud_tv_next_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Next: No current data available."
                android:textColor="#A0FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right: Live Broadcast Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_frosted_panel"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ISDB-T"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LAYER 2: Floating Side Drawer Toggle Button ("<") on Right Edge -->
    <ImageButton
        android:id="@+id/btn_open_side_panel"
        android:layout_width="44dp"
        android:layout_height="52dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_frosted_hud"
        android:elevation="20dp"
        android:focusable="true"
        android:clickable="true"
        android:padding="10dp"
        android:src="@drawable/ic_chevron_left"
        app:tint="#FFFFFF"
        android:visibility="visible" />


    <!-- LAYER 3: Right Side Translucent Frosted Panel (Channels / EPG / Favorites / Settings) -->
    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_frosted_panel"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Tab Layout: Channels, EPG, Favorites, Settings -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            app:tabBackground="@drawable/bg_tab_selector"
            app:tabGravity="fill"
            app:tabIndicatorColor="#FFD700"
            app:tabIndicatorHeight="4dp"
            app:tabMode="fixed"
            app:tabRippleColor="#20FFFFFF"
            app:tabSelectedTextColor="#FFD700"
            app:tabTextColor="#B0FFFFFF" />

        <!-- Content RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />

    </LinearLayout>

</FrameLayout>
