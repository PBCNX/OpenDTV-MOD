<?xml version="1.0" encoding="utf-8"?>
<!-- Analyzer status board, portrait. Compact on purpose: state + channel + the
     watch strip's word chips on one line, the three numbers inline under it,
     metadata last. Margins live on the <include>, not here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analyzer_board"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_scan_sheet"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/board_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/board_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:fontFamily="sans-serif-medium"
            android:text=""
            android:textColor="@color/odtv_on_surface"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/board_channel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/odtv_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/board_chip_data"
            style="@style/Widget.OpenDtv.StatusChip.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="DATA" />

        <TextView
            android:id="@+id/board_chip_cc"
            style="@style/Widget.OpenDtv.StatusChip.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="CC" />

        <TextView
            android:id="@+id/board_chip_lock"
            style="@style/Widget.OpenDtv.StatusChip.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="LOCK" />

        <TextView
            android:id="@+id/board_chip_ewbs"
            style="@style/Widget.OpenDtv.StatusChip.Compact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="0dp"
            android:text="EWBS" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/board_strength_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.1"
            android:text="STRENGTH"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="·"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/board_quality_val"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.1"
            android:text="QUALITY"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="·"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/board_bitrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="—"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.1"
            android:text="MBPS"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/board_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/odtv_on_surface_variant"
        android:textSize="10sp" />
</LinearLayout>
