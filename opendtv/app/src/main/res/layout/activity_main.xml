<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="OpenDTV"
        app:titleTextColor="?attr/colorOnPrimary"
        app:menu="@menu/menu_main"
        app:popupTheme="@style/ThemeOverlay.Material3.Light" />

    <!-- TOP: fixed 16:9 video area (the video itself is letter/pillar-boxed inside, never stretched) -->
    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/player_frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        app:resize_mode="fixed_width">

        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:resize_mode="fill"
            app:show_buffering="when_playing"
            app:shutter_background_color="#000000"
            app:use_controller="false" />

        <!-- ARIB data broadcast (BML) page, transparent over the video. Empty until DATA is pressed on the remote. -->
        <FrameLayout
            android:id="@+id/bml_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <!-- Current Playing Channel Banner / Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_current_channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No channel tuned"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- TabLayout: Channels, EPG, Favorites -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill" />

    <!-- Content RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

</LinearLayout>

    <!-- BML remote: opened with the floating button. Navigation, 4 colour keys, DATA and BACK. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/remote_panel"
        style="?attr/materialCardViewElevatedStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="92dp"
        app:cardCornerRadius="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- navigation cross -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rm_up"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="64dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="▲"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rm_left"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="64dp"
                            android:layout_height="52dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:text="◀"
                            android:textSize="18sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rm_ok"
                            android:layout_width="64dp"
                            android:layout_height="52dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:text="OK"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/rm_right"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="64dp"
                            android:layout_height="52dp"
                            android:insetLeft="0dp"
                            android:insetRight="0dp"
                            android:minWidth="0dp"
                            android:padding="0dp"
                            android:text="▶"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rm_down"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="64dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center_horizontal"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="▼"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- DATA / BACK -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rm_data"
                        android:layout_width="96dp"
                        android:layout_height="64dp"
                        android:text="DATA" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rm_back"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="96dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="8dp"
                        android:text="BACK" />
                </LinearLayout>
            </LinearLayout>

            <!-- colour keys: blue, red, green, yellow (ARIB order) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rm_blue"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1E5BD8"
                    android:contentDescription="Blue"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rm_red"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#C62828"
                    android:contentDescription="Red"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rm_green"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2E7D32"
                    android:contentDescription="Green"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rm_yellow"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="#F9A825"
                    android:contentDescription="Yellow"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Material 3 floating button (bottom right): opens / closes the BML remote -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_remote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Remote"
        app:srcCompat="@drawable/ic_remote" />

</FrameLayout>
