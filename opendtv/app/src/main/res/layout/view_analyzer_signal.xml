<?xml version="1.0" encoding="utf-8"?>
<!-- Signal tab: the six counters plus a short status line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signal_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Three columns, two rows: reading across gives MBPS / PKTS / NULL, then
         CC ERR / TEI / SYNC LOSS. Two rows instead of three leaves the sparkline the
         height it needs; the owner's earlier note was that the graph looked squished. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tile_bitrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.1"
                android:text="MBPS"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tile_cc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.1"
                android:text="CC ERR"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tile_packets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.1"
                android:text="PKTS"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tile_tei"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.1"
                android:text="TEI"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tile_null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.1"
                android:text="NULL"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tile_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:letterSpacing="0.1"
                android:text="SYNC LOSS"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/odtv_divider" />

    <!-- Landscape only (the board that used to carry these is gone there): the two
         meters, the four status words, and the bitrate sparkline. They stay GONE in
         portrait, where the three-line board already shows the numbers and the words. -->
    <LinearLayout
        android:id="@+id/sig_meters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="74dp"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="STRENGTH"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:id="@+id/sig_strength_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/odtv_ok" />

                <View
                    android:id="@+id/sig_strength_rest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/odtv_surface_high" />
            </LinearLayout>

            <TextView
                android:id="@+id/sig_strength_val"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="74dp"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="QUALITY"
                android:textColor="@color/odtv_on_surface_variant"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View
                    android:id="@+id/sig_quality_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@color/odtv_accent" />

                <View
                    android:id="@+id/sig_quality_rest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/odtv_surface_high" />
            </LinearLayout>

            <TextView
                android:id="@+id/sig_quality_val"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="—"
                android:textColor="@color/odtv_on_surface"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <ph.opendtv.ui.SparklineView
        android:id="@+id/signal_spark"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sig_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/sig_chip_data"
            style="@style/Widget.OpenDtv.StatusChip.Landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="DATA" />

        <TextView
            android:id="@+id/sig_chip_cc"
            style="@style/Widget.OpenDtv.StatusChip.Landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="CC" />

        <TextView
            android:id="@+id/sig_chip_lock"
            style="@style/Widget.OpenDtv.StatusChip.Landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:text="LOCK" />

        <TextView
            android:id="@+id/sig_chip_ewbs"
            style="@style/Widget.OpenDtv.StatusChip.Landscape"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="EWBS" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/signal_line1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="monospace"
        android:textColor="@color/odtv_on_surface_variant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/signal_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/odtv_on_surface_variant"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/signal_line3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/odtv_on_surface_variant"
        android:textSize="11sp" />
</LinearLayout>
