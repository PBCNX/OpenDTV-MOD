<?xml version="1.0" encoding="utf-8"?>
<!-- Export diagnostics: the file's two opt-ins, both off by default. The checkbox rows are the
     only focus stops and carry the app's row plate, so a remote sees where it is; the action row
     is the app's own pill pair (same plate as Build info) instead of the platform button bar,
     which had no focus ring on the set and made this dialog look unlike the screen that opened it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="One small text file to send when reporting a bug. It is written on this device; nothing is uploaded."
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="Addresses, e-mail, phone numbers and absolute paths are redacted automatically."
        android:textColor="@color/odtv_on_surface_variant"
        android:textSize="12sp" />

    <CheckBox
        android:id="@+id/export_include_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_check_row_focusable"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Include device model and manufacturer"
        android:textColor="@color/odtv_on_surface"
        android:textSize="14sp" />

    <CheckBox
        android:id="@+id/export_include_channels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_check_row_focusable"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="Include channel names and frequencies"
        android:textColor="@color/odtv_on_surface"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="3dp"
        android:text="Both are off by default. The file is saved in OpenDTV/diagnostics, where the recordings live."
        android:textColor="@color/odtv_on_surface_variant"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/export_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_empty_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingStart="22dp"
            android:paddingTop="9dp"
            android:paddingEnd="22dp"
            android:paddingBottom="9dp"
            android:text="CANCEL"
            android:textColor="@color/odtv_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/export_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_empty_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:paddingStart="22dp"
            android:paddingTop="9dp"
            android:paddingEnd="22dp"
            android:paddingBottom="9dp"
            android:text="EXPORT"
            android:textColor="@color/odtv_accent"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
