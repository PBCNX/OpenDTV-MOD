<?xml version="1.0" encoding="utf-8"?>
<!-- Scrollable so the same actions fit a TV (1920) and a phone (407dp).
     Every item is focusable: on a TV this row is only reachable if it is. -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/analyzer_actions"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/action_channels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_empty_action"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="Channels"
            android:textColor="@color/odtv_accent"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_probe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="Probe"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="Record"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_export"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="Export .ts"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/action_usb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_tab_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:text="USB"
            android:textColor="@color/odtv_on_surface"
            android:textSize="14sp" />

    </LinearLayout>
</HorizontalScrollView>
