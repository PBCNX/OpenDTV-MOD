<?xml version="1.0" encoding="utf-8"?>
<!-- One card, two pages: the three location fields, and the list a field opens.
     The list is a page of this card, not a second dialog. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/ewbs_page_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp">

        <android.widget.Button
            android:id="@+id/ewbs_auto"
            style="@style/Widget.OpenDtv.DialogAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use current location" />

        <View
            android:id="@+id/ewbs_rule"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:background="@color/odtv_divider" />

        <include
            android:id="@+id/ewbs_row_zone"
            layout="@layout/view_picker_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp" />

        <include
            android:id="@+id/ewbs_row_region"
            layout="@layout/view_picker_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <include
            android:id="@+id/ewbs_row_city"
            layout="@layout/view_picker_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/ewbs_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ewbs_page_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/ewbs_list_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_item_focusable_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                android:tint="@color/odtv_on_surface_variant" />

            <TextView
                android:id="@+id/ewbs_list_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.OpenDtv.RowTitle" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/ewbs_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="8dp"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ewbs_list_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
