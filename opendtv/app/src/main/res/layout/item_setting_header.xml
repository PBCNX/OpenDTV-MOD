<?xml version="1.0" encoding="utf-8"?>
<!-- A section label: gold tick, optional icon, quiet caps. Sticky-looking without
     being sticky, and it leaves the rows themselves to carry the card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="24dp"
    android:paddingBottom="6dp">

    <View
        android:layout_width="3dp"
        android:layout_height="12dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_section_bar" />

    <ImageView
        android:id="@+id/iv_setting_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone"
        app:tint="@color/odtv_on_surface_variant" />

    <TextView
        android:id="@+id/tv_setting_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.OpenDtv.ListHeader" />

</LinearLayout>
