<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/odtv_bg"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Signal &amp; TS Analyzer"
            android:textColor="@color/odtv_on_surface"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/analyzer_mux_current"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scan_chip_focusable"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="—"
            android:textColor="@color/odtv_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 16:9 preview: the height below is the fallback, onCreate sets the real one -->
    <FrameLayout
        android:id="@+id/preview_box"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="#000000">

        <androidx.media3.ui.AspectRatioFrameLayout
            android:id="@+id/player_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.media3.ui.PlayerView
                android:id="@+id/player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:show_buffering="never"
                app:use_controller="false" />
        </androidx.media3.ui.AspectRatioFrameLayout>
    </FrameLayout>

    <include
        layout="@layout/view_analyzer_board"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include
            layout="@layout/view_analyzer_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/odtv_divider" />

        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_scan_sheet"
            android:padding="12dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tv_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/odtv_on_surface"
                    android:textSize="12sp" />
            </ScrollView>

            <include
                layout="@layout/view_analyzer_signal"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/view_analyzer_services"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/view_analyzer_pids"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/view_analyzer_tables"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/view_analyzer_graph"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include
                layout="@layout/view_analyzer_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- stays last: the blocking card owns the tab content -->
            <include
                layout="@layout/view_analyzer_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <include
        layout="@layout/view_analyzer_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/view_analyzer_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
