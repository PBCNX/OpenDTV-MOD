<?xml version="1.0" encoding="utf-8"?>
<!-- Logs tab: every setStatus line, levelled and coloured. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/logs_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16"
            android:text="SESSION LOG"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/logs_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/odtv_on_surface_variant"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/odtv_divider" />

    <ScrollView
        android:id="@+id/logs_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tab_selector"
        android:focusable="true"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:scrollbarSize="3dp"
        android:scrollbarStyle="insideInset"
        android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
        android:scrollbarDefaultDelayBeforeFade="700"
        android:scrollbarFadeDuration="250"
        android:scrollbarAlwaysDrawVerticalTrack="false">

        <TextView
            android:id="@+id/logs_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/odtv_on_surface"
            android:textSize="11sp" />
    </ScrollView>
</LinearLayout>
