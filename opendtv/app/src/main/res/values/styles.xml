<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.OpenDtv.Toolbar" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/odtv_on_surface</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.OpenDtv.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/odtv_on_surface_variant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.OpenDtv.Tab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- One tab strip in portrait and in the landscape side panel: gold label +
         underline for the selection, a thin gold outline only while focused by
         the remote. No filled pill in either state. -->
    <style name="Widget.OpenDtv.Tabs" parent="Widget.Material3.TabLayout">
        <item name="tabBackground">@drawable/bg_tab_selector</item>
        <item name="tabIndicatorColor">@color/odtv_accent</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabSelectedTextColor">@color/odtv_accent</item>
        <item name="tabTextColor">@color/odtv_on_surface_variant</item>
        <item name="tabRippleColor">@android:color/transparent</item>
        <item name="tabTextAppearance">@style/TextAppearance.OpenDtv.Tab</item>
    </style>

    <style name="TextAppearance.OpenDtv.ListHeader" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textColor">@color/odtv_on_surface_variant</item>
    </style>

    <style name="TextAppearance.OpenDtv.ListCount" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/odtv_accent</item>
    </style>

    <style name="TextAppearance.OpenDtv.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/odtv_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- The quiet outlined action used by the empty states and the dialogs:
         gold label, thin accent border, gold ring only while focused. -->
    <style name="Widget.OpenDtv.DialogAction" parent="">
        <item name="android:background">@drawable/bg_empty_action</item>
        <item name="android:textColor">@color/odtv_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.OpenDtv.StatusChip" parent="">
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:textColor">@color/odtv_ok</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Widget.OpenDtv.StatusChip.Compact" parent="Widget.OpenDtv.StatusChip">
        <item name="android:textSize">8sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingStart">5dp</item>
        <item name="android:paddingEnd">5dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:visibility">visible</item>
    </style>

    <!-- The same word chips on the one-line landscape board: two points bigger than
         the portrait row, since that screen is read from across a room. -->
    <style name="Widget.OpenDtv.StatusChip.Landscape" parent="Widget.OpenDtv.StatusChip.Compact">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Analyzer tab label: focusable for the TV remote, ring only when focused. -->
    <style name="Widget.OpenDtv.TabLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:background">@drawable/bg_tab_selector</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/analyzer_tab_text</item>
    </style>
</resources>
